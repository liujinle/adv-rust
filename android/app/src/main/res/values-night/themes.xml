<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Adv" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/adv_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- 深色下的启动主题，见 values/themes.xml 的说明。 -->
    <style name="Theme.Adv.Guest" parent="Theme.Adv">
        <item name="android:windowSplashScreenBackground">@color/guest_launch_background</item>
        <item name="android:windowDisablePreview">true</item>
    </style>
</resources>
