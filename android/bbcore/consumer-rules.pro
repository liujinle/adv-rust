# Keep the JNI entry points reachable: R8 must not rename native methods, otherwise
# the symbol names generated by the Rust side no longer match.
-keepclasseswithmembernames,includedescriptorclasses class com.adv.bb.nativebridge.NativeBridge {
    native <methods>;
}

# The engine handle and task snapshots cross the JNI boundary as JSON strings, so
# no model class needs to be kept by name.
